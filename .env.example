# ───────── 브라우저 공개 설정 (NEXT_PUBLIC_) ─────────
# 앱 주소 (초대 링크에 사용)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Firebase 콘솔 › 프로젝트 설정 › 내 앱(웹)
NEXT_PUBLIC_FIREBASE_API_KEY=
# iOS 로그인 안정화를 위해 앱 도메인을 넣는다 (예: your-app.vercel.app). README 3단계 참고
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase 콘솔 › 프로젝트 설정 › 클라우드 메시징 › 웹 푸시 인증서 (키 쌍)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Google Maps — 브라우저용 Key (HTTP 리퍼러 제한 필수: Maps JavaScript API, Places API (New)만 허용)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ───────── 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것) ─────────
# Firebase 서비스 계정 (프로젝트 설정 › 서비스 계정 › 새 비공개 키)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Maps — 서버용 Key (Geocoding API만 허용, 리퍼러 제한 없음)
GOOGLE_MAPS_SERVER_KEY=

# 호출 응답 대기 시간(초). 명세: 기본 60~90초, 운영 데이터로 조정
CALL_TIMEOUT_SECONDS=90

# 매일 1회 구글 좌표 보관기한(30일) 정리 — Vercel Cron이 Authorization 헤더로 보낸다. 긴 무작위 문자열
CRON_SECRET=

# 운영자 도구(익명 통계 리포트·자체 장소 목록)를 쓸 Google 계정 이메일, 쉼표로 구분
OPERATOR_EMAILS=
